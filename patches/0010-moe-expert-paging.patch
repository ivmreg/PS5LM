+++ b/tests/test-backend-sched-copy-callback.cpp
@@ -0,0 +1,197 @@
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "../ggml/src/ggml-backend-impl.h"
+#include "ggml-cpu.h"
+
+#include <cstdio>
+#include <memory>
+
+struct backend_deleter {
+    void operator()(ggml_backend * backend) const {
+        ggml_backend_free(backend);
+    }
+};
+
+struct buffer_deleter {
+    void operator()(ggml_backend_buffer * buffer) const {
+        ggml_backend_buffer_free(buffer);
+    }
+};
+
+struct context_deleter {
+    void operator()(ggml_context * context) const {
+        ggml_free(context);
+    }
+};
+
+using backend_ptr = std::unique_ptr<ggml_backend, backend_deleter>;
+using buffer_ptr = std::unique_ptr<ggml_backend_buffer, buffer_deleter>;
+using context_ptr = std::unique_ptr<ggml_context, context_deleter>;
+
+enum copy_mode {
+    COPY_LEGACY_NOT_HANDLED,
+    COPY_LEGACY_HANDLED,
+    COPY_V2_NOT_HANDLED,
+    COPY_V2_HANDLED,
+    COPY_V2_ERROR,
+};
+
+struct callback_data {
+    copy_mode mode;
+    int calls;
+};
+
+static void write_custom_weight(ggml_tensor * dst) {
+    const float values[] = { 10.0f, 11.0f, 12.0f, 13.0f };
+    ggml_backend_tensor_set(dst, values, 0, sizeof(values));
+}
+
+static bool copy_callback_legacy(ggml_backend_t, const ggml_tensor *, ggml_tensor * dst, ggml_cgraph *, void * user_data) {
+    callback_data * data = (callback_data *) user_data;
+    data->calls++;
+    if (data->mode == COPY_LEGACY_HANDLED) {
+        write_custom_weight(dst);
+        return true;
+    }
+    return false;
+}
+
+static ggml_backend_sched_copy_result copy_callback_v2(ggml_backend_t, const ggml_tensor *, ggml_tensor * dst, ggml_cgraph *, void * user_data) {
+    callback_data * data = (callback_data *) user_data;
+    data->calls++;
+    switch (data->mode) {
+        case COPY_V2_NOT_HANDLED:
+            return GGML_BACKEND_SCHED_COPY_NOT_HANDLED;
+        case COPY_V2_HANDLED:
+            write_custom_weight(dst);
+            return GGML_BACKEND_SCHED_COPY_HANDLED;
+        case COPY_V2_ERROR:
+            return GGML_BACKEND_SCHED_COPY_ERROR;
+        default:
+            return GGML_BACKEND_SCHED_COPY_ERROR;
+    }
+}
+
+static ggml_backend_buffer_type custom_buft;
+
+static bool custom_supports_buft(ggml_backend_dev_t, ggml_backend_buffer_type_t buft) {
+    return buft == &custom_buft;
+}
+
+static ggml_backend_buffer_type_t custom_get_buffer_type(ggml_backend_dev_t) {
+    return &custom_buft;
+}
+
+static bool run_case(copy_mode mode) {
+    backend_ptr backend_a(ggml_backend_cpu_init());
+    backend_ptr backend_b(ggml_backend_cpu_init());
+    if (!backend_a || !backend_b) {
+        return false;
+    }
+
+    custom_buft = *ggml_backend_cpu_buffer_type();
+    struct ggml_backend_device custom_dev = *backend_b->device;
+    custom_dev.iface.supports_buft = custom_supports_buft;
+    custom_dev.iface.get_buffer_type = custom_get_buffer_type;
+    custom_buft.device = &custom_dev;
+    backend_b->device = &custom_dev;
+
+    ggml_init_params params = { 1024 * 1024, NULL, true };
+    context_ptr ctx_input(ggml_init(params));
+    context_ptr ctx_weight(ggml_init(params));
+    context_ptr ctx_graph(ggml_init(params));
+    if (!ctx_input || !ctx_weight || !ctx_graph) {
+        return false;
+    }
+
+    ggml_tensor * input = ggml_new_tensor_1d(ctx_input.get(), GGML_TYPE_F32, 4);
+    ggml_tensor * weight = ggml_new_tensor_1d(ctx_weight.get(), GGML_TYPE_F32, 4);
+    buffer_ptr input_buffer(ggml_backend_alloc_ctx_tensors(ctx_input.get(), backend_a.get()));
+    buffer_ptr weight_buffer(ggml_backend_alloc_ctx_tensors(ctx_weight.get(), backend_a.get()));
+    if (!input_buffer || !weight_buffer) {
+        return false;
+    }
+    ggml_backend_buffer_set_usage(weight_buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    const float input_values[] = { 1.0f, 1.0f, 1.0f, 1.0f };
+    const float weight_values[] = { 2.0f, 3.0f, 4.0f, 5.0f };
+    ggml_backend_tensor_set(input, input_values, 0, sizeof(input_values));
+    ggml_backend_tensor_set(weight, weight_values, 0, sizeof(weight_values));
+
+    ggml_tensor * prior = ggml_scale(ctx_graph.get(), input, 3.0f);
+    ggml_tensor * first = ggml_add(ctx_graph.get(), prior, weight);
+    ggml_tensor * second = ggml_scale(ctx_graph.get(), first, 2.0f);
+    ggml_set_output(second);
+    ggml_cgraph * graph = ggml_new_graph(ctx_graph.get());
+    ggml_build_forward_expand(graph, second);
+
+    ggml_backend_t backends[] = { backend_a.get(), backend_b.get() };
+    ggml_backend_buffer_type_t bufts[] = {
+        ggml_backend_cpu_buffer_type(),
+        &custom_buft,
+    };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, bufts, 2, 16, false, false);
+    ggml_backend_sched_set_tensor_backend(sched, input, backend_a.get());
+    ggml_backend_sched_set_tensor_backend(sched, weight, backend_a.get());
+    ggml_backend_sched_set_tensor_backend(sched, prior, backend_a.get());
+    ggml_backend_sched_set_tensor_backend(sched, first, backend_b.get());
+    ggml_backend_sched_set_tensor_backend(sched, second, backend_a.get());
+
+    callback_data data = { mode, 0 };
+    if (mode == COPY_LEGACY_NOT_HANDLED || mode == COPY_LEGACY_HANDLED) {
+        ggml_backend_sched_set_copy_callback(sched, copy_callback_legacy, &data);
+    } else {
+        ggml_backend_sched_set_copy_callback_v2(sched, copy_callback_v2, &data);
+    }
+
+    bool ok = ggml_backend_sched_alloc_graph(sched, graph) && ggml_backend_sched_get_n_splits(sched) == 3;
+    if (ok && mode == COPY_V2_ERROR) {
+        ok = (ggml_backend_sched_graph_compute_async(sched, graph) == GGML_STATUS_FAILED);
+        float first_result[4];
+        float second_result[4];
+        float prior_result[4];
+        ggml_backend_tensor_get(prior, prior_result, 0, sizeof(prior_result));
+        ggml_backend_tensor_get(first, first_result, 0, sizeof(first_result));
+        ggml_backend_tensor_get(second, second_result, 0, sizeof(second_result));
+        for (int i = 0; i < 4; i++) {
+            const float computed_first = (input_values[i] * 3.0f + weight_values[i]);
+            const float computed_second = computed_first * 2.0f;
+            ok = ok && prior_result[i] == input_values[i] * 3.0f &&
+                first_result[i] != computed_first && second_result[i] != computed_second;
+        }
+    } else if (ok) {
+        ok = (ggml_backend_sched_graph_compute(sched, graph) == GGML_STATUS_SUCCESS);
+        const float expected_weight[] = {
+            mode == COPY_LEGACY_HANDLED || mode == COPY_V2_HANDLED ? 10.0f : 2.0f,
+            mode == COPY_LEGACY_HANDLED || mode == COPY_V2_HANDLED ? 11.0f : 3.0f,
+            mode == COPY_LEGACY_HANDLED || mode == COPY_V2_HANDLED ? 12.0f : 4.0f,
+            mode == COPY_LEGACY_HANDLED || mode == COPY_V2_HANDLED ? 13.0f : 5.0f,
+        };
+        float result[4];
+        ggml_backend_tensor_get(second, result, 0, sizeof(result));
+        for (int i = 0; i < 4; i++) {
+            ok = ok && result[i] == (input_values[i] * 3.0f + expected_weight[i]) * 2.0f;
+        }
+    }
+
+    ok = ok && data.calls == 1;
+    ggml_backend_sched_free(sched);
+    return ok;
+}
+
+int main() {
+    const copy_mode modes[] = {
+        COPY_LEGACY_NOT_HANDLED,
+        COPY_LEGACY_HANDLED,
+        COPY_V2_NOT_HANDLED,
+        COPY_V2_HANDLED,
+        COPY_V2_ERROR,
+    };
+    for (copy_mode mode : modes) {
+        if (!run_case(mode)) {
+            std::fprintf(stderr, "scheduler copy callback test failed for mode %d\n", (int) mode);
+            return 1;
+        }
+    }
+    return 0;
+}
diff --git a/tests/test-moe-paged-loader.cpp b/tests/test-moe-paged-loader.cpp
new file mode 100644
index 0000000..ab5d1a4
--- /dev/null
+++ b/tests/test-moe-paged-loader.cpp
@@ -0,0 +1,303 @@
+#include "../src/llama-model-loader.h"
+#include "../src/llama-model.h"
+
+#include "gguf.h"
+#include "llama.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+struct temp_file {
+    std::string path;
+
+    temp_file() {
+        std::array<char, 64> name{};
+        std::strcpy(name.data(), "/tmp/llama-moe-paged-XXXXXX");
+        const int fd = mkstemp(name.data());
+        if (fd < 0) {
+            throw std::runtime_error("mkstemp failed");
+        }
+        close(fd);
+        path = name.data();
+    }
+
+    temp_file(const temp_file &) = delete;
+    temp_file & operator=(const temp_file &) = delete;
+
+    temp_file(temp_file && other) noexcept : path(std::move(other.path)) {
+        other.path.clear();
+    }
+
+    ~temp_file() {
+        if (!path.empty()) {
+            unlink(path.c_str());
+        }
+    }
+};
+
+static void add_tensor(gguf_context * gguf, ggml_tensor * tensor) {
+    gguf_add_tensor(gguf, tensor);
+    gguf_set_tensor_data(gguf, tensor->name, tensor->data);
+}
+
+static temp_file make_fixture(const char * architecture, bool split) {
+    temp_file file;
+
+    ggml_init_params init{};
+    init.mem_size = 1 << 20;
+    ggml_context * tensors = ggml_init(init);
+    require(tensors != nullptr, "ggml_init failed");
+
+    auto * gate = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * up   = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * down = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * norm = ggml_new_tensor_1d(tensors, GGML_TYPE_F32, 4);
+    require(gate && up && down && norm, "synthetic tensors allocation failed");
+
+    ggml_set_name(gate, "blk.0.ffn_gate_exps.weight");
+    ggml_set_name(up,   "blk.0.ffn_up_exps.weight");
+    ggml_set_name(down, "blk.0.ffn_down_exps.weight");
+    ggml_set_name(norm, "blk.0.attn_norm.weight");
+    std::memset(gate->data, 0x11, ggml_nbytes(gate));
+    std::memset(up->data,   0x22, ggml_nbytes(up));
+    std::memset(down->data, 0x33, ggml_nbytes(down));
+    std::memset(norm->data, 0x44, ggml_nbytes(norm));
+
+    gguf_context * gguf = gguf_init_empty();
+    require(gguf != nullptr, "gguf_init_empty failed");
+    gguf_set_val_str(gguf, "general.architecture", architecture);
+    if (split) {
+        gguf_set_val_u16(gguf, "split.count", 2);
+    }
+    add_tensor(gguf, gate);
+    add_tensor(gguf, up);
+    add_tensor(gguf, down);
+    add_tensor(gguf, norm);
+
+    const bool wrote = gguf_write_to_file(gguf, file.path.c_str(), false);
+    gguf_free(gguf);
+    ggml_free(tensors);
+    require(wrote, "writing synthetic GGUF failed");
+    return file;
+}
+
+static int open_fd_count() {
+    long limit = sysconf(_SC_OPEN_MAX);
+    if (limit <= 0) {
+        limit = 1024;
+    }
+    limit = std::min<long>(limit, 4096);
+    int count = 0;
+    for (int fd = 0; fd < limit; ++fd) {
+        if (fcntl(fd, F_GETFD) >= 0) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+static void test_metadata_only_expert_plan() {
+    auto file = make_fixture("qwen3moe", false);
+    std::vector<std::string> splits;
+
+    auto * cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    require(cpu != nullptr, "CPU backend not available");
+    const buft_list_t cpu_buft{{cpu, ggml_backend_dev_buffer_type(cpu)}};
+
+    {
+        llama_model_loader loader(nullptr, nullptr, nullptr, file.path, splits, nullptr,
+                LLAMA_LOAD_MODE_NONE, false, false, false, true, nullptr, nullptr);
+
+        llama_hparams hparams{};
+        hparams.n_expert = 2;
+        hparams.n_layer_all = 1;
+        const LLM_TN tn(LLM_ARCH_QWEN3MOE);
+
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_GATE_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "gate expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_UP_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "up expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "down expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_ATTN_NORM, "weight", 0), {4}, 0) != nullptr,
+                "dense tensor metadata creation failed");
+        loader.done_getting_tensors();
+
+        require(loader.paged_expert_descriptors.size() == 3, "expected three expert descriptors");
+        require(loader.paged_expert_tensor_ids.size() == 3, "expected three expert tensor IDs");
+
+        std::size_t paged_tensor_count = 0;
+        for (const auto & entry : loader.ctx_map) {
+            if (!entry.first.paged) {
+                continue;
+            }
+            for (ggml_tensor * tensor = ggml_get_first_tensor(entry.second.get()); tensor;
+                    tensor = ggml_get_next_tensor(entry.second.get(), tensor)) {
+                require(tensor->data == nullptr, "expert metadata unexpectedly owns a tensor-sized payload");
+                ++paged_tensor_count;
+            }
+        }
+        require(paged_tensor_count == 3, "all experts must occupy the paged context");
+
+        loader.init_mappings();
+        require(loader.mappings.empty(), "page mode must not mmap any model file");
+        require(loader.size_data == sizeof(float) * 4, "ordinary load byte budget must exclude all expert payloads");
+        require(loader.size_done == 0, "metadata planning must not account any expert payload as loaded");
+
+        auto opened = loader.open_paged_expert_source(1024);
+        require(opened.ok(), "opening the synthetic expert source failed");
+        require(opened.source->tensor_count() == 3, "source must retain only three expert descriptors");
+        require(loader.size_done == 0, "opening the source must not read expert payloads");
+    }
+}
+
+static void test_rejected_split_closes_file() {
+    auto file = make_fixture("qwen3moe", true);
+    std::vector<std::string> splits;
+    const int before = open_fd_count();
+    bool rejected = false;
+    try {
+        llama_model_loader loader(nullptr, nullptr, nullptr, file.path, splits, nullptr,
+                LLAMA_LOAD_MODE_NONE, false, false, false, true, nullptr, nullptr);
+    } catch (const std::exception & e) {
+        rejected = std::string(e.what()).find("split GGUF") != std::string::npos;
+    }
+    require(rejected, "split GGUF paging request must fail explicitly");
+    require(open_fd_count() == before, "failed split load leaked an open shard descriptor");
+}
+
+static void test_public_model_load_fails_closed() {
+    auto file = make_fixture("qwen3moe", false);
+    auto params = llama_model_default_params();
+    params.use_moe_expert_paging = true;
+    params.load_mode = LLAMA_LOAD_MODE_NONE;
+    params.split_mode = LLAMA_SPLIT_MODE_NONE;
+    params.lazy_mode = LLAMA_LAZY_MODE_OFF;
+    params.use_extra_bufts = false;
+    require(llama_model_load_from_file(file.path.c_str(), params) == nullptr,
+            "incomplete synthetic Qwen3MoE load must fail before returning a model");
+}
+
+static std::string find_fixture_path(const std::string & rel_path) {
+    const char * env_path = std::getenv("PS5LM_FIXTURE_PATH");
+    if (env_path && access(env_path, R_OK) == 0) {
+        return env_path;
+    }
+    const std::vector<std::string> prefixes = {
+        "",
+        "./",
+        "../",
+        "../../",
+        "../../../",
+        "../../../../",
+    };
+    for (const auto & p : prefixes) {
+        std::string cand = p + rel_path;
+        if (access(cand.c_str(), R_OK) == 0) {
+            return cand;
+        }
+    }
+    return "";
+}
+
+static void test_qwen3moe_tiny_fixture_loader() {
+    const std::string fixture_path = find_fixture_path("tests/fixtures/moe_paging/qwen3moe-tiny-f32.gguf");
+    if (fixture_path.empty()) {
+        std::fprintf(stderr, "warning: qwen3moe-tiny-f32.gguf fixture not found, skipping fixture loader test\n");
+        return;
+    }
+
+    auto params_res = llama_model_default_params();
+    params_res.use_moe_expert_paging = false;
+    params_res.use_extra_bufts = false;
+    llama_model * model_res = llama_model_load_from_file(fixture_path.c_str(), params_res);
+    require(model_res != nullptr, "resident tiny model load failed");
+
+    auto params_paged = llama_model_default_params();
+    params_paged.use_moe_expert_paging = true;
+    params_paged.use_extra_bufts = false;
+    llama_model * model_paged = llama_model_load_from_file(fixture_path.c_str(), params_paged);
+    require(model_paged != nullptr, "paged tiny model load failed");
+    require(model_paged->has_paged_experts, "has_paged_experts must be true");
+
+    const auto * source = model_paged->paged_expert_source();
+    require(source != nullptr, "paged_expert_source() must not be null");
+
+    const int n_layer = model_paged->hparams.n_layer();
+    const int n_expert = model_paged->hparams.n_expert;
+    require(n_layer > 0 && n_expert > 0, "invalid model dimensions");
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer_res = model_res->layers[il];
+        const auto & layer_paged = model_paged->layers[il];
+
+        const std::pair<const ggml_tensor *, const ggml_tensor *> pairs[] = {
+            {layer_res.ffn_gate_exps, layer_paged.ffn_gate_exps},
+            {layer_res.ffn_up_exps,   layer_paged.ffn_up_exps},
+            {layer_res.ffn_down_exps, layer_paged.ffn_down_exps},
+        };
+
+        for (const auto & [t_res, t_paged] : pairs) {
+            require(t_res != nullptr, "resident expert tensor missing");
+            require(t_paged != nullptr, "paged expert tensor missing");
+            require(t_res->data != nullptr, "resident expert tensor must have data");
+            require(t_paged->data == nullptr, "paged expert tensor must NOT have resident data");
+            require(ggml_backend_buffer_get_size(t_paged->buffer) == 0, "paged expert tensor buffer size must be 0");
+
+            uint64_t tensor_id = 0;
+            require(model_paged->paged_expert_tensor_id(t_paged, &tensor_id), "paged_expert_tensor_id lookup failed");
+            require(tensor_id > 0, "tensor_id must be non-zero");
+
+            const size_t slice_bytes = static_cast<size_t>(t_paged->nb[2]);
+            std::vector<uint8_t> slice_buf(slice_bytes);
+
+            for (int e = 0; e < n_expert; ++e) {
+                const auto read_err = source->read_expert(tensor_id, e, slice_buf.data(), slice_bytes);
+                require(read_err.ok(), "read_expert failed");
+
+                const uint8_t * res_ptr = static_cast<const uint8_t *>(t_res->data) + e * t_res->nb[2];
+                require(std::memcmp(slice_buf.data(), res_ptr, slice_bytes) == 0, "paged expert slice byte mismatch");
+            }
+        }
+    }
+
+    llama_model_free(model_res);
+    llama_model_free(model_paged);
+}
+
+int main() {
+    try {
+        llama_backend_init();
+        test_metadata_only_expert_plan();
+        test_rejected_split_closes_file();
+        test_public_model_load_fails_closed();
+        test_qwen3moe_tiny_fixture_loader();
+        llama_backend_free();
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "test-moe-paged-loader: %s\n", e.what());
+        llama_backend_free();
+        return 1;
+    }
+    std::fprintf(stderr, "test-moe-paged-loader: passed\n");
+    return 0;
+}
diff --git a/tests/test-moe-paging-inference.cpp b/tests/test-moe-paging-inference.cpp
new file mode 100644
index 0000000..46bfe78
--- /dev/null
+++ b/tests/test-moe-paging-inference.cpp
@@ -0,0 +1,494 @@
+// Integration test for Qwen3MoE Non-Resident Expert Paging & Inference Parity.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "llama.h"
+#include "../src/llama-model.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+static void llama_batch_clear(struct llama_batch & batch) {
+    batch.n_tokens = 0;
+}
+
+static void llama_batch_add(
+        struct llama_batch & batch,
+        llama_token id,
+        llama_pos pos,
+        std::initializer_list<llama_seq_id> seq_ids,
+        bool logits) {
+    const int32_t idx = batch.n_tokens;
+    batch.token   [idx] = id;
+    batch.pos     [idx] = pos;
+    batch.n_seq_id[idx] = seq_ids.size();
+    size_t i = 0;
+    for (llama_seq_id sid : seq_ids) {
+        batch.seq_id[idx][i++] = sid;
+    }
+    batch.logits  [idx] = logits;
+    batch.n_tokens++;
+}
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static std::string find_fixture_path(const std::string & rel_path) {
+    const char * env_path = std::getenv("PS5LM_FIXTURE_PATH");
+    if (env_path && access(env_path, R_OK) == 0) {
+        return env_path;
+    }
+    const std::vector<std::string> prefixes = {
+        "",
+        "./",
+        "../",
+        "../../",
+        "../../../",
+        "../../../../",
+    };
+    for (const auto & p : prefixes) {
+        std::string cand = p + rel_path;
+        if (access(cand.c_str(), R_OK) == 0) {
+            return cand;
+        }
+    }
+    return "";
+}
+
+static void assert_logits_parity(const std::vector<float> & a, const std::vector<float> & b, float tol = 1e-5f) {
+    require(a.size() == b.size(), "logits dimension mismatch");
+    float max_diff = 0.0f;
+    for (size_t i = 0; i < a.size(); ++i) {
+        float diff = std::fabs(a[i] - b[i]);
+        if (diff > max_diff) {
+            max_diff = diff;
+        }
+    }
+    if (max_diff >= tol) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf), "logits parity violated: max diff %g >= %g", max_diff, tol);
+        throw std::runtime_error(buf);
+    }
+}
