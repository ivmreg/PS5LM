diff --git a/src/paging_runtime.cpp b/src/paging_runtime.cpp
new file mode 100644
index 0000000..fd99f86
--- /dev/null
+++ b/src/paging_runtime.cpp
@@ -0,0 +1,345 @@
+// Synchronous per-layer adapter between ExpertSource and SlotCache.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "paging_runtime.hpp"
+
+#include <algorithm>
+#include <array>
+#include <exception>
+#include <new>
+#include <utility>
+
+namespace ps5lm::moe {
+
+const char * paging_status_name(PagingStatus status) noexcept {
+    switch (status) {
+        case PagingStatus::Ok: return "ok";
+        case PagingStatus::InvalidConfiguration: return "invalid_configuration";
+        case PagingStatus::InvalidLayer: return "invalid_layer";
+        case PagingStatus::RequestTooLarge: return "request_too_large";
+        case PagingStatus::Cancelled: return "cancelled";
+        case PagingStatus::CacheFailure: return "cache_failure";
+        case PagingStatus::SourceFailure: return "source_failure";
+        case PagingStatus::UploadRejected: return "upload_rejected";
+        case PagingStatus::UploadFailed: return "upload_failed";
+        case PagingStatus::FenceUnresolved: return "fence_unresolved";
+        case PagingStatus::Quarantined: return "quarantined";
+        case PagingStatus::OutOfMemory: return "out_of_memory";
+    }
+    return "unknown";
+}
+
+PagingQuarantine::PagingQuarantine(std::size_t staging_capacity) {
+    if (staging_capacity != 0) {
+        staging_.resize(staging_capacity);
+    }
+}
+
+PagingQuarantine::~PagingQuarantine() noexcept {
+    // Dropping an unresolved Reservation would invoke its rollback destructor,
+    // potentially making a slot available while a transfer still uses it.
+    if (leased_ || pending_) {
+        std::terminate();
+    }
+}
+
+bool PagingQuarantine::acquire(ExpertUploadBackend & backend) noexcept {
+    if (leased_ || pending_ || staging_.empty() || (backend_ != nullptr && backend_ != &backend)) {
+        return false;
+    }
+    leased_ = true;
+    backend_ = &backend;
+    return true;
+}
+
+void PagingQuarantine::release() noexcept {
+    leased_ = false;
+}
+
+void PagingQuarantine::quarantine(
+        Reservation && reservation,
+        ExpertKey key,
+        ExpertTensorRole role,
+        std::size_t slot,
+        UploadToken transfer) noexcept {
+    if (pending_ || !reservation.active() || !leased_ || backend_ == nullptr) {
+        std::terminate();
+    }
+    pending_.emplace(std::move(reservation));
+    pending_transfer_ = transfer;
+    pending_key_ = key;
+    pending_role_ = role;
+    pending_slot_ = slot;
+}
+
+QuarantineStatus PagingQuarantine::release_after_backend_quiesced(ExpertUploadBackend & backend) noexcept {
+    if (!pending_) {
+        return QuarantineStatus::NotPending;
+    }
+    if (backend_ != &backend) {
+        return QuarantineStatus::StillUnsafe;
+    }
+    const TransferFenceStatus status = backend.quiesce();
+    if (status == TransferFenceStatus::Indeterminate) {
+        return QuarantineStatus::StillUnsafe;
+    }
+    pending_->rollback();
+    pending_.reset();
+    pending_transfer_ = 0;
+    pending_key_ = {};
+    pending_role_ = ExpertTensorRole::Gate;
+    pending_slot_ = kNoSlot;
+    if (!leased_) {
+        backend_ = nullptr;
+    }
+    return QuarantineStatus::Released;
+}
+
+PagingRuntime::PagingRuntime(
+        SlotCache & cache,
+        const ExpertSource & source,
+        ExpertUploadBackend & backend,
+        PagingQuarantine & quarantine,
+        const std::vector<LayerExpertTensorIds> & tensor_ids,
+        std::size_t max_selected_experts)
+    : cache_(cache),
+      source_(source),
+      backend_(backend),
+      quarantine_(quarantine),
+      max_selected_experts_(max_selected_experts) {
+    if (cache.configuration_status() != SlotCacheStatus::Ok ||
+        source.max_expert_bytes() == 0 || quarantine.staging_capacity() == 0 ||
+        quarantine.staging_capacity() > source.max_expert_bytes() ||
+        max_selected_experts == 0 || max_selected_experts > kHardSelectedExpertLimit ||
+        tensor_ids.empty() || tensor_ids.size() > kHardLayerLimit) {
+        configuration_status_ = PagingStatus::InvalidConfiguration;
+        return;
+    }
+
+    try {
+        for (const LayerExpertTensorIds & layer : tensor_ids) {
+            const std::array<ExpertTensorRef, 3> refs = {layer.gate, layer.up, layer.down};
+            if (refs[0].tensor_id == refs[1].tensor_id || refs[0].tensor_id == refs[2].tensor_id ||
+                refs[1].tensor_id == refs[2].tensor_id) {
+                configuration_status_ = PagingStatus::InvalidConfiguration;
+                return;
+            }
+            for (const ExpertTensorRef & ref : refs) {
+                if (ref.bytes_per_expert == 0 || ref.bytes_per_expert > quarantine.staging_capacity()) {
+                    configuration_status_ = PagingStatus::InvalidConfiguration;
+                    return;
+                }
+            }
+            if (!tensor_ids_.emplace(layer.layer, layer).second) {
+                configuration_status_ = PagingStatus::InvalidConfiguration;
+                return;
+            }
+        }
+    } catch (const std::bad_alloc &) {
+        configuration_status_ = PagingStatus::OutOfMemory;
+        return;
+    } catch (...) {
+        configuration_status_ = PagingStatus::OutOfMemory;
+        return;
+    }
+
+    if (!quarantine.acquire(backend)) {
+        configuration_status_ = PagingStatus::InvalidConfiguration;
+        return;
+    }
+    leased_ = true;
+    configuration_status_ = PagingStatus::Ok;
+}
+
+PagingRuntime::~PagingRuntime() noexcept {
+    if (leased_) {
+        quarantine_.release();
+    }
+}
+
+const LayerExpertTensorIds * PagingRuntime::find_layer(std::uint32_t layer) const noexcept {
+    const auto found = tensor_ids_.find(layer);
+    return found == tensor_ids_.end() ? nullptr : &found->second;
+}
+
+bool PagingRuntime::is_cancelled(const std::atomic_bool * cancelled) const noexcept {
+    return cancelled != nullptr && cancelled->load(std::memory_order_relaxed);
+}
+
+PagingResult PagingRuntime::fail_with_cache(PagingResult result, SlotCacheStatus status) const noexcept {
+    result.status = PagingStatus::CacheFailure;
+    result.cache_status = status;
+    return result;
+}
+
+PagingResult PagingRuntime::load_layer(
+        std::uint32_t layer,
+        const std::vector<std::uint32_t> & selected_experts,
+        CompletionToken gpu_use_token,
+        const std::atomic_bool * cancelled) noexcept {
+    PagingResult result;
+    if (configuration_status_ != PagingStatus::Ok) {
+        result.status = configuration_status_;
+        return result;
+    }
+    if (poisoned_ || quarantine_.pending()) {
+        result.status = PagingStatus::Quarantined;
+        return result;
+    }
+    if (is_cancelled(cancelled)) {
+        result.status = PagingStatus::Cancelled;
+        return result;
+    }
+    if (selected_experts.empty()) {
+        return fail_with_cache(std::move(result), SlotCacheStatus::InvalidRequest);
+    }
+    if (selected_experts.size() > max_selected_experts_) {
+        result.status = PagingStatus::RequestTooLarge;
+        return result;
+    }
+    const LayerExpertTensorIds * tensors = find_layer(layer);
+    if (tensors == nullptr) {
+        result.status = PagingStatus::InvalidLayer;
+        return result;
+    }
+
+    std::vector<ExpertKey> keys;
+    try {
+        keys.reserve(selected_experts.size());
+        for (const std::uint32_t expert : selected_experts) {
+            keys.push_back({layer, expert});
+        }
+    } catch (...) {
+        result.status = PagingStatus::OutOfMemory;
+        return result;
+    }
+
+    ReserveResult reserved;
+    try {
+        reserved = cache_.reserve(keys);
+    } catch (...) {
+        result.status = PagingStatus::OutOfMemory;
+        return result;
+    }
+    if (!reserved.ok()) {
+        return fail_with_cache(std::move(result), reserved.status);
+    }
+    Reservation & reservation = reserved.reservation;
+
+    const std::array<std::pair<ExpertTensorRole, ExpertTensorRef>, 3> roles = {{
+        {ExpertTensorRole::Gate, tensors->gate},
+        {ExpertTensorRole::Up,   tensors->up},
+        {ExpertTensorRole::Down, tensors->down},
+    }};
+
+    for (const SlotAssignment & assignment : reservation.assignments()) {
+        if (!assignment.needs_upload) {
+            continue;
+        }
+        for (const auto & role_ref : roles) {
+            const ExpertTensorRole role = role_ref.first;
+            const ExpertTensorRef & tensor = role_ref.second;
+            result.failed_key = assignment.key;
+            result.failed_role = role;
+
+            if (is_cancelled(cancelled)) {
+                reservation.rollback();
+                result.status = PagingStatus::Cancelled;
+                return result;
+            }
+
+            std::fill_n(quarantine_.staging_.begin(), tensor.bytes_per_expert, 0);
+            const ReadError read = source_.read_expert(
+                    tensor.tensor_id,
+                    assignment.key.expert,
+                    quarantine_.staging_.data(),
+                    tensor.bytes_per_expert,
+                    cancelled);
+            if (!read.ok()) {
+                reservation.rollback();
+                result.read_error = read;
+                result.status = read.status == ReadStatus::Cancelled ?
+                        PagingStatus::Cancelled : PagingStatus::SourceFailure;
+                return result;
+            }
+
+            if (is_cancelled(cancelled)) {
+                reservation.rollback();
+                result.status = PagingStatus::Cancelled;
+                return result;
+            }
+
+            const UploadSubmission submission = backend_.submit_upload(
+                    assignment.key,
+                    role,
+                    assignment.slot,
+                    quarantine_.staging_.data(),
+                    tensor.bytes_per_expert);
+            if (!submission.submitted) {
+                reservation.rollback();
+                result.status = PagingStatus::UploadRejected;
+                return result;
+            }
+
+            result.transfer_token = submission.token;
+            if (submission.token == 0) {
+                quarantine_.quarantine(
+                        std::move(reservation), assignment.key, role, assignment.slot, submission.token);
+                poisoned_ = true;
+                result.status = PagingStatus::FenceUnresolved;
+                return result;
+            }
+
+            const TransferFenceStatus transfer_status = backend_.wait_transfer(submission.token);
+            if (transfer_status == TransferFenceStatus::Indeterminate) {
+                quarantine_.quarantine(
+                        std::move(reservation), assignment.key, role, assignment.slot, submission.token);
+                poisoned_ = true;
+                result.status = PagingStatus::FenceUnresolved;
+                return result;
+            }
+            if (transfer_status == TransferFenceStatus::FailedButQuiesced) {
+                reservation.rollback();
+                result.status = PagingStatus::UploadFailed;
+                return result;
+            }
+
+            if (is_cancelled(cancelled)) {
+                reservation.rollback();
+                result.status = PagingStatus::Cancelled;
+                return result;
+            }
+        }
+
+        const SlotCacheStatus marked = reservation.mark_upload_complete(assignment.key);
+        if (marked != SlotCacheStatus::Ok) {
+            reservation.rollback();
+            return fail_with_cache(std::move(result), marked);
+        }
+    }
+
+    if (is_cancelled(cancelled)) {
+        reservation.rollback();
+        result.status = PagingStatus::Cancelled;
+        return result;
+    }
+
+    try {
+        result.assignments = reservation.assignments();
+    } catch (...) {
+        reservation.rollback();
+        result.status = PagingStatus::OutOfMemory;
+        return result;
+    }
+    const SlotCacheStatus committed = reservation.commit(gpu_use_token);
+    if (committed != SlotCacheStatus::Ok) {
+        reservation.rollback();
+        result.assignments.clear();
+        return fail_with_cache(std::move(result), committed);
+    }
+    result.gpu_use_token = gpu_use_token;
+    result.status = PagingStatus::Ok;
+    return result;
+}
+
+}  // namespace ps5lm::moe
diff --git a/src/paging_runtime.hpp b/src/paging_runtime.hpp
new file mode 100644
index 0000000..8df87fb
--- /dev/null
+++ b/src/paging_runtime.hpp
@@ -0,0 +1,195 @@
+// Synchronous per-layer adapter between ExpertSource and SlotCache.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "expert_source.hpp"
+#include "slot_cache.hpp"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+
+namespace ps5lm::moe {
+
+using UploadToken = std::uint64_t;
+
+enum class ExpertTensorRole : std::uint8_t { Gate, Up, Down };
+
+struct ExpertTensorRef {
+    std::uint64_t tensor_id = 0;
+    // Exact per-expert stride from the same validated metadata used to build
+    // ExpertSource. ExpertSource::read_expert does not return a byte count.
+    std::size_t bytes_per_expert = 0;
+};
+
+struct LayerExpertTensorIds {
+    std::uint32_t layer = 0;
+    ExpertTensorRef gate{};
+    ExpertTensorRef up{};
+    ExpertTensorRef down{};
+};
+
+enum class TransferFenceStatus : std::uint8_t {
+    Complete,
+    FailedButQuiesced,
+    Indeterminate,
+};
+
+struct UploadSubmission {
+    // false guarantees that no work was accepted and the source pointer is no
+    // longer retained. true requires a valid token unless the caller will
+    // quarantine and globally quiesce the backend.
+    bool submitted = false;
+    UploadToken token = 0;
+};
+
+// Backend contract: submit_upload() may retain source_bytes only while its
+// returned token is outstanding. wait_transfer() must return Complete or
+// FailedButQuiesced only when it guarantees no further source/destination
+// access. Indeterminate means the caller cannot reuse either resource.
+class ExpertUploadBackend {
+public:
+    virtual ~ExpertUploadBackend() = default;
+
+    virtual UploadSubmission submit_upload(
+            ExpertKey key,
+            ExpertTensorRole role,
+            std::size_t slot,
+            const void * source_bytes,
+            std::size_t byte_count) noexcept = 0;
+
+    virtual TransferFenceStatus wait_transfer(UploadToken token) noexcept = 0;
+
+    // Stops/drains all accepted transfers. Only Complete or FailedButQuiesced
+    // confirms that no outstanding transfer can access staging or cache slots.
+    virtual TransferFenceStatus quiesce() noexcept = 0;
+};
+
+enum class PagingStatus : std::uint8_t {
+    Ok,
+    InvalidConfiguration,
+    InvalidLayer,
+    RequestTooLarge,
+    Cancelled,
+    CacheFailure,
+    SourceFailure,
+    UploadRejected,
+    UploadFailed,
+    FenceUnresolved,
+    Quarantined,
+    OutOfMemory,
+};
+
+const char * paging_status_name(PagingStatus status) noexcept;
+
+struct PagingResult {
+    PagingStatus status = PagingStatus::InvalidConfiguration;
+    SlotCacheStatus cache_status = SlotCacheStatus::Ok;
+    ReadError read_error{};
+    ExpertKey failed_key{};
+    ExpertTensorRole failed_role = ExpertTensorRole::Gate;
+    UploadToken transfer_token = 0;
+    CompletionToken gpu_use_token = 0;
+    std::vector<SlotAssignment> assignments;
+
+    bool ok() const noexcept { return status == PagingStatus::Ok; }
+};
+
+enum class QuarantineStatus : std::uint8_t {
+    Released,
+    NotPending,
+    StillUnsafe,
+};
+
+// Owns exactly one fixed reusable staging buffer. If a transfer fence becomes
+// indeterminate it also owns the active reservation, preventing slot rollback
+// and staging destruction until backend-wide quiescence is confirmed.
+class PagingQuarantine final {
+public:
+    explicit PagingQuarantine(std::size_t staging_capacity);
+    ~PagingQuarantine() noexcept;
+    PagingQuarantine(const PagingQuarantine &) = delete;
+    PagingQuarantine & operator=(const PagingQuarantine &) = delete;
+
+    std::size_t staging_capacity() const noexcept { return staging_.size(); }
+    bool pending() const noexcept { return pending_.has_value(); }
+    UploadToken pending_transfer() const noexcept { return pending_transfer_; }
+    ExpertKey pending_key() const noexcept { return pending_key_; }
+    ExpertTensorRole pending_role() const noexcept { return pending_role_; }
+    std::size_t pending_slot() const noexcept { return pending_slot_; }
+
+    // This method calls backend.quiesce(). It releases the reservation only
+    // after a result that guarantees no transfer remains in flight.
+    QuarantineStatus release_after_backend_quiesced(ExpertUploadBackend & backend) noexcept;
+
+private:
+    friend class PagingRuntime;
+
+    bool acquire(ExpertUploadBackend & backend) noexcept;
+    void release() noexcept;
+    void quarantine(
+            Reservation && reservation,
+            ExpertKey key,
+            ExpertTensorRole role,
+            std::size_t slot,
+            UploadToken transfer) noexcept;
+
+    std::vector<std::uint8_t> staging_;
+    std::optional<Reservation> pending_;
+    bool leased_ = false;
+    ExpertUploadBackend * backend_ = nullptr;
+    UploadToken pending_transfer_ = 0;
+    ExpertKey pending_key_{};
+    ExpertTensorRole pending_role_ = ExpertTensorRole::Gate;
+    std::size_t pending_slot_ = kNoSlot;
+};
+
+class PagingRuntime final {
+public:
+    static constexpr std::size_t kHardLayerLimit = 1024;
+    static constexpr std::size_t kHardSelectedExpertLimit = 256;
+
+    PagingRuntime(
+            SlotCache & cache,
+            const ExpertSource & source,
+            ExpertUploadBackend & backend,
+            PagingQuarantine & quarantine,
+            const std::vector<LayerExpertTensorIds> & tensor_ids,
+            std::size_t max_selected_experts = 64);
+    ~PagingRuntime() noexcept;
+    PagingRuntime(const PagingRuntime &) = delete;
+    PagingRuntime & operator=(const PagingRuntime &) = delete;
+
+    PagingStatus configuration_status() const noexcept { return configuration_status_; }
+    bool poisoned() const noexcept { return poisoned_; }
+
+    // Uploads every selected expert's gate, up and down slices for one layer.
+    // Duplicate expert IDs consume one cache slot and one set of role reads.
+    // The caller must not submit GPU compute using assignments until this
+    // returns Ok; gpu_use_token pins the slots until SlotCache::complete().
+    PagingResult load_layer(
+            std::uint32_t layer,
+            const std::vector<std::uint32_t> & selected_experts,
+            CompletionToken gpu_use_token,
+            const std::atomic_bool * cancelled = nullptr) noexcept;
+
+private:
+    const LayerExpertTensorIds * find_layer(std::uint32_t layer) const noexcept;
+    bool is_cancelled(const std::atomic_bool * cancelled) const noexcept;
+    PagingResult fail_with_cache(PagingResult result, SlotCacheStatus status) const noexcept;
+
+    SlotCache & cache_;
+    const ExpertSource & source_;
+    ExpertUploadBackend & backend_;
+    PagingQuarantine & quarantine_;
+    std::map<std::uint32_t, LayerExpertTensorIds> tensor_ids_;
+    std::size_t max_selected_experts_ = 0;
+    PagingStatus configuration_status_ = PagingStatus::InvalidConfiguration;
+    bool leased_ = false;
+    bool poisoned_ = false;
+};
+
+}  // namespace ps5lm::moe
diff --git a/src/slot_cache.cpp b/src/slot_cache.cpp
new file mode 100644
index 0000000..69423df
--- /dev/null
+++ b/src/slot_cache.cpp
@@ -0,0 +1,474 @@
+// Backend-independent transactional slot policy for MoE expert paging.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "slot_cache.hpp"
+
+#include <algorithm>
+#include <limits>
+#include <new>
+#include <utility>
+
+namespace ps5lm::moe {
+namespace {
+
+bool checked_multiply(std::size_t a, std::size_t b, std::size_t * out) noexcept {
+    if (out == nullptr || (a != 0 && b > std::numeric_limits<std::size_t>::max() / a)) {
+        return false;
+    }
+    *out = a * b;
+    return true;
+}
+
+}  // namespace
+
+const char * slot_cache_status_name(SlotCacheStatus status) noexcept {
+    switch (status) {
+        case SlotCacheStatus::Ok: return "ok";
+        case SlotCacheStatus::InvalidConfiguration: return "invalid_configuration";
+        case SlotCacheStatus::BudgetExceeded: return "budget_exceeded";
+        case SlotCacheStatus::TooManySlots: return "too_many_slots";
+        case SlotCacheStatus::OutOfMemory: return "out_of_memory";
+        case SlotCacheStatus::InvalidRequest: return "invalid_request";
+        case SlotCacheStatus::RequestTooLarge: return "request_too_large";
+        case SlotCacheStatus::TooManyUniqueExperts: return "too_many_unique_experts";
+        case SlotCacheStatus::TooManyOutstandingBatches: return "too_many_outstanding_batches";
+        case SlotCacheStatus::KeyReserved: return "key_reserved";
+        case SlotCacheStatus::InsufficientUnpinnedSlots: return "insufficient_unpinned_slots";
+        case SlotCacheStatus::InvalidReservation: return "invalid_reservation";
+        case SlotCacheStatus::UploadNotRequired: return "upload_not_required";
+        case SlotCacheStatus::UploadsIncomplete: return "uploads_incomplete";
+        case SlotCacheStatus::InvalidCompletionToken: return "invalid_completion_token";
+        case SlotCacheStatus::TooManyInFlightTokens: return "too_many_in_flight_tokens";
+        case SlotCacheStatus::UnknownCompletionToken: return "unknown_completion_token";
+        case SlotCacheStatus::InternalError: return "internal_error";
+    }
+    return "unknown";
+}
+
+Reservation::Reservation(
+        SlotCache * owner,
+        std::uint64_t id,
+        std::vector<SlotAssignment> assignments) noexcept
+    : owner_(owner), id_(id), active_(owner != nullptr), assignments_(std::move(assignments)) {}
+
+Reservation::~Reservation() noexcept {
+    rollback();
+}
+
+Reservation::Reservation(Reservation && other) noexcept
+    : owner_(other.owner_),
+      id_(other.id_),
+      active_(other.active_),
+      assignments_(std::move(other.assignments_)) {
+    other.owner_ = nullptr;
+    other.id_ = 0;
+    other.active_ = false;
+}
+
+Reservation & Reservation::operator=(Reservation && other) noexcept {
+    if (this != &other) {
+        rollback();
+        owner_ = other.owner_;
+        id_ = other.id_;
+        active_ = other.active_;
+        assignments_ = std::move(other.assignments_);
+        other.owner_ = nullptr;
+        other.id_ = 0;
+        other.active_ = false;
+    }
+    return *this;
+}
+
+bool Reservation::slot_for(ExpertKey key, std::size_t * slot_out) const noexcept {
+    if (!active_ || slot_out == nullptr) {
+        return false;
+    }
+    for (const SlotAssignment & assignment : assignments_) {
+        if (assignment.key == key) {
+            *slot_out = assignment.slot;
+            return true;
+        }
+    }
+    return false;
+}
+
+SlotCacheStatus Reservation::mark_upload_complete(ExpertKey key) noexcept {
+    if (!active_ || owner_ == nullptr) {
+        return SlotCacheStatus::InvalidReservation;
+    }
+    for (SlotAssignment & assignment : assignments_) {
+        if (assignment.key == key) {
+            if (!assignment.needs_upload) {
+                return SlotCacheStatus::UploadNotRequired;
+            }
+            assignment.upload_complete = true;
+            return SlotCacheStatus::Ok;
+        }
+    }
+    return SlotCacheStatus::InvalidRequest;
+}
+
+SlotCacheStatus Reservation::commit(CompletionToken token) noexcept {
+    if (!active_ || owner_ == nullptr) {
+        return SlotCacheStatus::InvalidReservation;
+    }
+    return owner_->commit(*this, token);
+}
+
+void Reservation::rollback() noexcept {
+    if (active_ && owner_ != nullptr) {
+        owner_->rollback(*this);
+    }
+}
+
+SlotCache::SlotCache(const SlotCacheOptions & options) noexcept : options_(options) {
+    if (options.slot_count == 0 || options.bytes_per_slot == 0 || options.byte_budget == 0 ||
+        options.max_request_keys == 0 || options.max_in_flight_tokens == 0) {
+        configuration_status_ = SlotCacheStatus::InvalidConfiguration;
+        return;
+    }
+    if (options.slot_count > kHardSlotLimit) {
+        configuration_status_ = SlotCacheStatus::TooManySlots;
+        return;
+    }
+    if (options.max_request_keys > kHardRequestKeyLimit ||
+        options.max_in_flight_tokens > kHardInFlightLimit) {
+        configuration_status_ = SlotCacheStatus::InvalidConfiguration;
+        return;
+    }
+    if (!checked_multiply(options.slot_count, options.bytes_per_slot, &configured_capacity_bytes_)) {
+        configuration_status_ = SlotCacheStatus::InvalidConfiguration;
+        return;
+    }
+    if (configured_capacity_bytes_ > options.byte_budget) {
+        configuration_status_ = SlotCacheStatus::BudgetExceeded;
+        return;
+    }
+    try {
+        slots_.resize(options.slot_count);
+    } catch (const std::bad_alloc &) {
+        configuration_status_ = SlotCacheStatus::OutOfMemory;
+        return;
+    } catch (...) {
+        configuration_status_ = SlotCacheStatus::OutOfMemory;
+        return;
+    }
+    configuration_status_ = SlotCacheStatus::Ok;
+}
+
+std::size_t SlotCache::find_resident_locked(ExpertKey key) const noexcept {
+    for (std::size_t i = 0; i < slots_.size(); ++i) {
+        const Slot & slot = slots_[i];
+        if (slot.state == State::Resident && slot.key == key) {
+            return i;
+        }
+    }
+    return kNoSlot;
+}
+
+std::size_t SlotCache::find_reserved_locked(ExpertKey key) const noexcept {
+    for (std::size_t i = 0; i < slots_.size(); ++i) {
+        const Slot & slot = slots_[i];
+        if (slot.state == State::Reserved && slot.key == key) {
+            return i;
+        }
+    }
+    return kNoSlot;
+}
+
+std::uint64_t SlotCache::next_lru_stamp() noexcept {
+    if (lru_clock_ != std::numeric_limits<std::uint64_t>::max()) {
+        return ++lru_clock_;
+    }
+    // This is only reachable after 2^64 cache touches. Saturating keeps the
+    // operation defined; ties are then resolved by the lowest slot index.
+    return lru_clock_;
+}
+
+ReserveResult SlotCache::reserve(const std::vector<ExpertKey> & requested) {
+    ReserveResult result;
+    result.status = configuration_status_;
+    if (configuration_status_ != SlotCacheStatus::Ok) {
+        return result;
+    }
+    if (requested.empty()) {
+        result.status = SlotCacheStatus::InvalidRequest;
+        return result;
+    }
+    if (requested.size() > options_.max_request_keys) {
+        result.status = SlotCacheStatus::RequestTooLarge;
+        return result;
+    }
+
+    std::vector<SlotAssignment> assignments;
+    std::vector<bool> protected_slots;
+    try {
+        assignments.reserve(requested.size());
+        protected_slots.resize(slots_.size(), false);
+        for (const ExpertKey key : requested) {
+            const auto found = std::find_if(assignments.begin(), assignments.end(),
+                    [key](const SlotAssignment & entry) { return entry.key == key; });
+            if (found == assignments.end()) {
+                assignments.push_back({key, kNoSlot, false, false});
+            }
+        }
+    } catch (...) {
+        result.status = SlotCacheStatus::OutOfMemory;
+        return result;
+    }
+    if (assignments.size() > slots_.size()) {
+        result.status = SlotCacheStatus::TooManyUniqueExperts;
+        return result;
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (active_reservations_ >= kHardInFlightLimit) {
+        result.status = SlotCacheStatus::TooManyOutstandingBatches;
+        return result;
+    }
+
+    // Resolve all hits first. A matching in-progress upload conflicts with
+    // the entire request; no partial slot state is changed in this pass.
+    for (SlotAssignment & assignment : assignments) {
+        const std::size_t resident = find_resident_locked(assignment.key);
+        if (resident != kNoSlot) {
+            assignment.slot = resident;
+            protected_slots[resident] = true;
+            continue;
+        }
+        if (find_reserved_locked(assignment.key) != kNoSlot) {
+            result.status = SlotCacheStatus::KeyReserved;
+            return result;
+        }
+        assignment.needs_upload = true;
+    }
+
+    // Plan every miss before mutating the cache. Empty slots are preferred;
+    // otherwise choose the oldest resident slot that has no reservation or
+    // GPU-use pins. Hits and earlier candidates are excluded.
+    for (SlotAssignment & assignment : assignments) {
+        if (!assignment.needs_upload) {
+            continue;
+        }
+        std::size_t candidate = kNoSlot;
+        for (std::size_t i = 0; i < slots_.size(); ++i) {
+            if (!protected_slots[i] && slots_[i].state == State::Empty) {
+                candidate = i;
+                break;
+            }
+        }
+        if (candidate == kNoSlot) {
+            std::uint64_t oldest = std::numeric_limits<std::uint64_t>::max();
+            for (std::size_t i = 0; i < slots_.size(); ++i) {
+                const Slot & slot = slots_[i];
+                if (protected_slots[i] || slot.state != State::Resident ||
+                    slot.reservation_refs != 0 || slot.gpu_use_refs != 0) {
+                    continue;
+                }
+                if (candidate == kNoSlot || slot.last_use < oldest) {
+                    candidate = i;
+                    oldest = slot.last_use;
+                }
+            }
+        }
+        if (candidate == kNoSlot) {
+            result.status = SlotCacheStatus::InsufficientUnpinnedSlots;
+            return result;
+        }
+        assignment.slot = candidate;
+        protected_slots[candidate] = true;
+    }
+
+    std::uint64_t id = next_transaction_id_++;
+    if (id == 0) {
+        id = next_transaction_id_++;
+    }
+    if (next_transaction_id_ == 0) {
+        next_transaction_id_ = 1;
+    }
+    for (const SlotAssignment & assignment : assignments) {
+        Slot & slot = slots_[assignment.slot];
+        if (assignment.needs_upload) {
+            slot.state = State::Reserved;
+            slot.key = assignment.key;
+            slot.reservation_refs = 0;
+            slot.gpu_use_refs = 0;
+            slot.pending_transaction = id;
+            slot.last_use = next_lru_stamp();
+        } else {
+            ++slot.reservation_refs;
+        }
+    }
+    ++active_reservations_;
+    result.status = SlotCacheStatus::Ok;
+    result.reservation = Reservation(this, id, std::move(assignments));
+    return result;
+}
+
+SlotCacheStatus SlotCache::commit(Reservation & reservation, CompletionToken token) noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!reservation.active_ || reservation.owner_ != this || reservation.id_ == 0) {
+        return SlotCacheStatus::InvalidReservation;
+    }
+    if (token == 0 || token <= last_completion_token_) {
+        return SlotCacheStatus::InvalidCompletionToken;
+    }
+    if (token_slots_.size() >= options_.max_in_flight_tokens) {
+        return SlotCacheStatus::TooManyInFlightTokens;
+    }
+    for (const SlotAssignment & assignment : reservation.assignments_) {
+        if (assignment.needs_upload && !assignment.upload_complete) {
+            return SlotCacheStatus::UploadsIncomplete;
+        }
+        if (assignment.slot >= slots_.size()) {
+            return SlotCacheStatus::InternalError;
+        }
+        const Slot & slot = slots_[assignment.slot];
+        if (assignment.needs_upload) {
+            if (slot.state != State::Reserved || slot.pending_transaction != reservation.id_ ||
+                slot.key != assignment.key) {
+                return SlotCacheStatus::InvalidReservation;
+            }
+        } else if (slot.state != State::Resident || slot.key != assignment.key ||
+                   slot.reservation_refs == 0) {
+                return SlotCacheStatus::InvalidReservation;
+        }
+    }
+
+    std::vector<std::size_t> pinned_slots;
+    try {
+        pinned_slots.reserve(reservation.assignments_.size());
+        for (const SlotAssignment & assignment : reservation.assignments_) {
+            pinned_slots.push_back(assignment.slot);
+        }
+        const auto inserted = token_slots_.emplace(token, std::move(pinned_slots));
+        if (!inserted.second) {
+            return SlotCacheStatus::InvalidCompletionToken;
+        }
+    } catch (...) {
+        return SlotCacheStatus::OutOfMemory;
+    }
+
+    for (const SlotAssignment & assignment : reservation.assignments_) {
+        Slot & slot = slots_[assignment.slot];
+        if (assignment.needs_upload) {
+            slot.state = State::Resident;
+            slot.pending_transaction = 0;
+        } else {
+            --slot.reservation_refs;
+        }
+        ++slot.gpu_use_refs;
+        slot.last_use = next_lru_stamp();
+    }
+    last_completion_token_ = token;
+    if (active_reservations_ != 0) {
+        --active_reservations_;
+    }
+    reservation.owner_ = nullptr;
+    reservation.id_ = 0;
+    reservation.active_ = false;
+    reservation.assignments_.clear();
+    return SlotCacheStatus::Ok;
+}
+
+void SlotCache::rollback(Reservation & reservation) noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!reservation.active_ || reservation.owner_ != this || reservation.id_ == 0) {
+        reservation.owner_ = nullptr;
+        reservation.id_ = 0;
+        reservation.active_ = false;
+        reservation.assignments_.clear();
+        return;
+    }
+    for (const SlotAssignment & assignment : reservation.assignments_) {
+        if (assignment.slot >= slots_.size()) {
+            continue;
+        }
+        Slot & slot = slots_[assignment.slot];
+        if (assignment.needs_upload) {
+            if (slot.state == State::Reserved && slot.pending_transaction == reservation.id_) {
+                slot = Slot{};
+            }
+        } else if (slot.state == State::Resident && slot.key == assignment.key &&
+                   slot.reservation_refs != 0) {
+            --slot.reservation_refs;
+        }
+    }
+    if (active_reservations_ != 0) {
+        --active_reservations_;
+    }
+    reservation.owner_ = nullptr;
+    reservation.id_ = 0;
+    reservation.active_ = false;
+    reservation.assignments_.clear();
+}
+
+SlotCacheStatus SlotCache::complete(CompletionToken token) noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto found = token_slots_.find(token);
+    if (found == token_slots_.end()) {
+        return SlotCacheStatus::UnknownCompletionToken;
+    }
+    for (const std::size_t index : found->second) {
+        if (index >= slots_.size() || slots_[index].gpu_use_refs == 0) {
+            return SlotCacheStatus::InternalError;
+        }
+    }
+    for (const std::size_t index : found->second) {
+        --slots_[index].gpu_use_refs;
+    }
+    token_slots_.erase(found);
+    return SlotCacheStatus::Ok;
+}
+
+bool SlotCache::find_slot(ExpertKey key, std::size_t * slot_out) const noexcept {
+    if (slot_out == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    const std::size_t found = find_resident_locked(key);
+    if (found == kNoSlot) {
+        return false;
+    }
+    *slot_out = found;
+    return true;
+}
+
+bool SlotCache::inspect_slot(std::size_t index, SlotView * view_out) const noexcept {
+    if (view_out == nullptr || index >= slots_.size()) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    const Slot & slot = slots_[index];
+    view_out->resident = slot.state == State::Resident;
+    view_out->reserved = slot.state == State::Reserved;
+    view_out->key = slot.key;
+    view_out->outstanding_reservations = slot.reservation_refs;
+    view_out->outstanding_gpu_uses = slot.gpu_use_refs;
+    return true;
+}
+
+SlotCacheStats SlotCache::stats() const noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    SlotCacheStats result;
+    result.capacity_slots = slots_.size();
+    result.bytes_per_slot = options_.bytes_per_slot;
+    result.configured_capacity_bytes = configured_capacity_bytes_;
+    result.byte_budget = options_.byte_budget;
+    result.metadata_bytes = slots_.capacity() * sizeof(Slot);
+    result.active_reservations = active_reservations_;
+    result.active_completion_tokens = token_slots_.size();
+    for (const Slot & slot : slots_) {
+        if (slot.state == State::Resident) {
+            ++result.resident_slots;
+        } else if (slot.state == State::Reserved) {
+            ++result.reserved_slots;
+        }
+        if (slot.gpu_use_refs != 0) {
+            ++result.pinned_slots;
+        }
+    }
+    return result;
+}
+
+}  // namespace ps5lm::moe
diff --git a/src/slot_cache.hpp b/src/slot_cache.hpp
new file mode 100644
index 0000000..9164a32
--- /dev/null
+++ b/src/slot_cache.hpp
@@ -0,0 +1,190 @@
+// Backend-independent transactional slot policy for MoE expert paging.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <vector>
+
+namespace ps5lm::moe {
+
+struct ExpertKey {
+    std::uint32_t layer = 0;
+    std::uint32_t expert = 0;
+
+    friend bool operator==(ExpertKey a, ExpertKey b) noexcept {
+        return a.layer == b.layer && a.expert == b.expert;
+    }
+    friend bool operator!=(ExpertKey a, ExpertKey b) noexcept { return !(a == b); }
+};
+
+using CompletionToken = std::uint64_t;
+constexpr std::size_t kNoSlot = static_cast<std::size_t>(-1);
+
+enum class SlotCacheStatus : std::uint8_t {
+    Ok,
+    InvalidConfiguration,
+    BudgetExceeded,
+    TooManySlots,
+    OutOfMemory,
+    InvalidRequest,
+    RequestTooLarge,
+    TooManyUniqueExperts,
+    TooManyOutstandingBatches,
+    KeyReserved,
+    InsufficientUnpinnedSlots,
+    InvalidReservation,
+    UploadNotRequired,
+    UploadsIncomplete,
+    InvalidCompletionToken,
+    TooManyInFlightTokens,
+    UnknownCompletionToken,
+    InternalError,
+};
+
+const char * slot_cache_status_name(SlotCacheStatus status) noexcept;
+
+struct SlotCacheOptions {
+    std::size_t slot_count = 0;
+    std::size_t bytes_per_slot = 0;
+    std::size_t byte_budget = 0;
+    std::size_t max_in_flight_tokens = 16;
+    std::size_t max_request_keys = 4096;
+};
+
+// One entry for each distinct requested identity. Repeated request IDs resolve
+// through slot_for() to this same assignment and never consume extra slots.
+struct SlotAssignment {
+    ExpertKey key{};
+    std::size_t slot = kNoSlot;
+    bool needs_upload = false;
+    bool upload_complete = false;
+};
+
+struct SlotCacheStats {
+    std::size_t capacity_slots = 0;
+    std::size_t resident_slots = 0;
+    std::size_t reserved_slots = 0;
+    std::size_t pinned_slots = 0;
+    std::size_t active_reservations = 0;
+    std::size_t active_completion_tokens = 0;
+    std::size_t bytes_per_slot = 0;
+    std::size_t configured_capacity_bytes = 0;
+    std::size_t byte_budget = 0;
+    std::size_t metadata_bytes = 0;
+};
+
+struct SlotView {
+    bool resident = false;
+    bool reserved = false;
+    ExpertKey key{};  // resident key or pending reservation key
+    std::size_t outstanding_reservations = 0;
+    std::size_t outstanding_gpu_uses = 0;
+};
+
+class SlotCache;
+
+class Reservation final {
+public:
+    Reservation() noexcept = default;
+    ~Reservation() noexcept;
+    Reservation(const Reservation &) = delete;
+    Reservation & operator=(const Reservation &) = delete;
+    Reservation(Reservation && other) noexcept;
+    Reservation & operator=(Reservation && other) noexcept;
+
+    bool active() const noexcept { return active_; }
+    const std::vector<SlotAssignment> & assignments() const noexcept { return assignments_; }
+    bool slot_for(ExpertKey key, std::size_t * slot_out) const noexcept;
+
+    // Call only after that key's read and upload have both completed. It is
+    // idempotent for a key that was already marked complete.
+    SlotCacheStatus mark_upload_complete(ExpertKey key) noexcept;
+
+    // Atomically publishes every newly uploaded key and pins all batch slots
+    // to this unique, monotonically increasing future GPU completion token.
+    // Uploads incomplete leaves the reservation active so the caller can
+    // finish or roll it back.
+    SlotCacheStatus commit(CompletionToken token) noexcept;
+
+    // Cancellation, read failure, or upload failure invalidates all pending
+    // slots and releases hit reservations. The handle's destructor rolls back
+    // an active reservation automatically.
+    void rollback() noexcept;
+
+private:
+    friend class SlotCache;
+    Reservation(SlotCache * owner, std::uint64_t id, std::vector<SlotAssignment> assignments) noexcept;
+
+    SlotCache * owner_ = nullptr;  // SlotCache must outlive its reservations
+    std::uint64_t id_ = 0;
+    bool active_ = false;
+    std::vector<SlotAssignment> assignments_;
+};
+
+struct ReserveResult {
+    SlotCacheStatus status = SlotCacheStatus::InvalidRequest;
+    Reservation reservation;
+    bool ok() const noexcept { return status == SlotCacheStatus::Ok && reservation.active(); }
+};
+
+class SlotCache final {
+public:
+    static constexpr std::size_t kHardSlotLimit = 4096;
+    static constexpr std::size_t kHardRequestKeyLimit = 4096;
+    static constexpr std::size_t kHardInFlightLimit = 256;
+
+    explicit SlotCache(const SlotCacheOptions & options) noexcept;
+    ~SlotCache() noexcept = default;
+    SlotCache(const SlotCache &) = delete;
+    SlotCache & operator=(const SlotCache &) = delete;
+
+    SlotCacheStatus configuration_status() const noexcept { return configuration_status_; }
+    std::size_t slot_count() const noexcept { return slots_.size(); }
+
+    // Reservation is all-or-nothing. It deduplicates repeated identities,
+    // protects hits and reserves enough empty/LRU-unpinned slots for every miss.
+    ReserveResult reserve(const std::vector<ExpertKey> & requested);
+
+    // Completes a fake/real timeline token. Only this operation releases the
+    // corresponding GPU-use pins. Unknown and repeated completion signals fail.
+    SlotCacheStatus complete(CompletionToken token) noexcept;
+
+    bool find_slot(ExpertKey key, std::size_t * slot_out) const noexcept;
+    bool inspect_slot(std::size_t index, SlotView * view_out) const noexcept;
+    SlotCacheStats stats() const noexcept;
+
+private:
+    friend class Reservation;
+
+    enum class State : std::uint8_t { Empty, Resident, Reserved };
+    struct Slot {
+        State state = State::Empty;
+        ExpertKey key{};
+        std::size_t reservation_refs = 0;
+        std::size_t gpu_use_refs = 0;
+        std::uint64_t pending_transaction = 0;
+        std::uint64_t last_use = 0;
+    };
+
+    SlotCacheStatus commit(Reservation & reservation, CompletionToken token) noexcept;
+    void rollback(Reservation & reservation) noexcept;
+    std::size_t find_resident_locked(ExpertKey key) const noexcept;
+    std::size_t find_reserved_locked(ExpertKey key) const noexcept;
+    std::uint64_t next_lru_stamp() noexcept;
+
+    mutable std::mutex mutex_;
+    std::vector<Slot> slots_;
+    std::map<CompletionToken, std::vector<std::size_t>> token_slots_;
+    SlotCacheOptions options_{};
+    SlotCacheStatus configuration_status_ = SlotCacheStatus::InvalidConfiguration;
+    std::size_t configured_capacity_bytes_ = 0;
+    std::size_t active_reservations_ = 0;
+    std::uint64_t next_transaction_id_ = 1;
+    std::uint64_t last_completion_token_ = 0;
+    std::uint64_t lru_clock_ = 0;
+};
+
+}  // namespace ps5lm::moe
