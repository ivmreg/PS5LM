+static void test_context_validation_and_budget_floor(const std::string & fixture_path) {
+    auto mparams = llama_model_default_params();
+    mparams.use_moe_expert_paging = true;
+    mparams.use_extra_bufts = false;
+    llama_model * model = llama_model_load_from_file(fixture_path.c_str(), mparams);
+    require(model != nullptr, "paged model load failed");
+    require(model->has_paged_experts, "has_paged_experts must be true");
+
+    // 1. n_ubatch > 1 must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 2;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 64 * 1024 * 1024;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when n_ubatch > 1");
+    }
+
+    // 2. n_seq_max > 1 must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 2;
+        cparams.moe_cache_size = 64 * 1024 * 1024;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when n_seq_max > 1");
+    }
+
+    // 3. moe_cache_size == 0 must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 0;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when moe_cache_size == 0");
+    }
+
+    // 4. embeddings == true must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 64 * 1024 * 1024;
+        cparams.embeddings = true;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when embeddings == true");
+    }
+
+    // 5. causal_attn == false must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 64 * 1024 * 1024;
+        cparams.attention_type = LLAMA_ATTENTION_TYPE_NON_CAUSAL;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when causal_attn == false");
+    }
+
+    // 6. moe_cache_size < budget_floor must fail closed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 512; // Far below minimum budget floor
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        if (ctx) { llama_free(ctx); }
+        require(ctx == nullptr, "must fail closed when moe_cache_size < budget_floor");
+    }
+
+    // 7. Valid parameters must succeed
+    {
+        auto cparams = llama_context_default_params();
+        cparams.n_ubatch = 1;
+        cparams.n_seq_max = 1;
+        cparams.moe_cache_size = 64 * 1024 * 1024;
+        llama_context * ctx = llama_init_from_model(model, cparams);
+        require(ctx != nullptr, "valid paged context initialization failed");
+        llama_free(ctx);
+    }
+
+    llama_model_free(model);
+}
