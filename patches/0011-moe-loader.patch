+static void test_metadata_only_expert_plan() {
+    auto file = make_fixture("qwen3moe", false);
+    std::vector<std::string> splits;
+
+    auto * cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    require(cpu != nullptr, "CPU backend not available");
+    const buft_list_t cpu_buft{{cpu, ggml_backend_dev_buffer_type(cpu)}};
+
+    {
+        llama_model_loader loader(nullptr, nullptr, nullptr, file.path, splits, nullptr,
+                LLAMA_LOAD_MODE_NONE, false, false, false, true, nullptr, nullptr);
+
+        llama_hparams hparams{};
+        hparams.n_expert = 2;
+        hparams.n_layer_all = 1;
+        const LLM_TN tn(LLM_ARCH_QWEN3MOE);
+
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_GATE_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "gate expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_UP_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "up expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", 0), {4, 4, 2}, 0) != nullptr,
+                "down expert tensor metadata creation failed");
+        require(loader.create_tensor(hparams, &cpu_buft, &cpu_buft, &cpu_buft, &cpu_buft,
+                    tn(LLM_TENSOR_ATTN_NORM, "weight", 0), {4}, 0) != nullptr,
+                "dense tensor metadata creation failed");
+        loader.done_getting_tensors();
+
+        require(loader.paged_expert_descriptors.size() == 3, "expected three expert descriptors");
+        require(loader.paged_expert_tensor_ids.size() == 3, "expected three expert tensor IDs");
+
+        std::size_t paged_tensor_count = 0;
+        for (const auto & entry : loader.ctx_map) {
+            if (!entry.first.paged) {
+                continue;
+            }
+            for (ggml_tensor * tensor = ggml_get_first_tensor(entry.second.get()); tensor;
+                    tensor = ggml_get_next_tensor(entry.second.get(), tensor)) {
+                require(tensor->data == nullptr, "expert metadata unexpectedly owns a tensor-sized payload");
+                ++paged_tensor_count;
+            }
+        }
+        require(paged_tensor_count == 3, "all experts must occupy the paged context");
+
+        loader.init_mappings();
+        require(loader.mappings.empty(), "page mode must not mmap any model file");
+        require(loader.size_data == sizeof(float) * 4, "ordinary load byte budget must exclude all expert payloads");
+        require(loader.size_done == 0, "metadata planning must not account any expert payload as loaded");
+
+        auto opened = loader.open_paged_expert_source(1024);
+        require(opened.ok(), "opening the synthetic expert source failed");
+        require(opened.source->tensor_count() == 3, "source must retain only three expert descriptors");
+        require(loader.size_done == 0, "opening the source must not read expert payloads");
+    }
+}
