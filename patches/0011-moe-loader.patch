+static void test_public_model_load_fails_closed() {
+    auto file = make_fixture("qwen3moe", false);
+    auto params = llama_model_default_params();
+    params.use_moe_expert_paging = true;
+    params.load_mode = LLAMA_LOAD_MODE_NONE;
+    params.split_mode = LLAMA_SPLIT_MODE_NONE;
+    params.lazy_mode = LLAMA_LAZY_MODE_OFF;
+    params.use_extra_bufts = false;
+    require(llama_model_load_from_file(file.path.c_str(), params) == nullptr,
+            "incomplete synthetic Qwen3MoE load must fail before returning a model");
+}
