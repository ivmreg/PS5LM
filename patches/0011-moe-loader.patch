+static void test_qwen3moe_tiny_fixture_loader() {
+    const std::string fixture_path = find_fixture_path("tests/fixtures/moe_paging/qwen3moe-tiny-f32.gguf");
+    if (fixture_path.empty()) {
+        std::fprintf(stderr, "warning: qwen3moe-tiny-f32.gguf fixture not found, skipping fixture loader test\n");
+        return;
+    }
+
+    auto params_res = llama_model_default_params();
+    params_res.use_moe_expert_paging = false;
+    params_res.use_extra_bufts = false;
+    llama_model * model_res = llama_model_load_from_file(fixture_path.c_str(), params_res);
+    require(model_res != nullptr, "resident tiny model load failed");
+
+    auto params_paged = llama_model_default_params();
+    params_paged.use_moe_expert_paging = true;
+    params_paged.use_extra_bufts = false;
+    llama_model * model_paged = llama_model_load_from_file(fixture_path.c_str(), params_paged);
+    require(model_paged != nullptr, "paged tiny model load failed");
+    require(model_paged->has_paged_experts, "has_paged_experts must be true");
+
+    const auto * source = model_paged->paged_expert_source();
+    require(source != nullptr, "paged_expert_source() must not be null");
+
+    const int n_layer = model_paged->hparams.n_layer();
+    const int n_expert = model_paged->hparams.n_expert;
+    require(n_layer > 0 && n_expert > 0, "invalid model dimensions");
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer_res = model_res->layers[il];
+        const auto & layer_paged = model_paged->layers[il];
+
+        const std::pair<const ggml_tensor *, const ggml_tensor *> pairs[] = {
+            {layer_res.ffn_gate_exps, layer_paged.ffn_gate_exps},
+            {layer_res.ffn_up_exps,   layer_paged.ffn_up_exps},
+            {layer_res.ffn_down_exps, layer_paged.ffn_down_exps},
+        };
+
+        for (const auto & [t_res, t_paged] : pairs) {
+            require(t_res != nullptr, "resident expert tensor missing");
+            require(t_paged != nullptr, "paged expert tensor missing");
+            require(t_res->data != nullptr, "resident expert tensor must have data");
+            require(t_paged->data == nullptr, "paged expert tensor must NOT have resident data");
+            require(ggml_backend_buffer_get_size(t_paged->buffer) == 0, "paged expert tensor buffer size must be 0");
+
+            uint64_t tensor_id = 0;
+            require(model_paged->paged_expert_tensor_id(t_paged, &tensor_id), "paged_expert_tensor_id lookup failed");
+            require(tensor_id > 0, "tensor_id must be non-zero");
+
+            const size_t slice_bytes = static_cast<size_t>(t_paged->nb[2]);
+            std::vector<uint8_t> slice_buf(slice_bytes);
+
+            for (int e = 0; e < n_expert; ++e) {
+                const auto read_err = source->read_expert(tensor_id, e, slice_buf.data(), slice_bytes);
+                require(read_err.ok(), "read_expert failed");
+
+                const uint8_t * res_ptr = static_cast<const uint8_t *>(t_res->data) + e * t_res->nb[2];
+                require(std::memcmp(slice_buf.data(), res_ptr, slice_bytes) == 0, "paged expert slice byte mismatch");
+            }
+        }
+    }
+
+    llama_model_free(model_res);
+    llama_model_free(model_paged);
+}
