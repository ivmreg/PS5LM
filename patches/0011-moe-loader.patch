+bool llama_model::paged_expert_tensor_id(const struct ggml_tensor * tensor, uint64_t * id_out) const {
+#if !defined(_WIN32)
+    if (!tensor) {
+        return false;
+    }
+    auto it = pimpl->paged_expert_tensor_ids.find(tensor);
+    if (it == pimpl->paged_expert_tensor_ids.end()) {
+        return false;
+    }
+    if (id_out) {
+        *id_out = it->second;
+    }
+    return true;
+#else
+    GGML_UNUSED(tensor);
+    GGML_UNUSED(id_out);
+    return false;
+#endif
+}
