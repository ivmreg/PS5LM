+int main() {
+    try {
+        llama_backend_init();
+        test_metadata_only_expert_plan();
+        test_rejected_split_closes_file();
+        test_public_model_load_fails_closed();
+        test_qwen3moe_tiny_fixture_loader();
+        llama_backend_free();
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "test-moe-paged-loader: %s\n", e.what());
+        llama_backend_free();
+        return 1;
+    }
+    std::fprintf(stderr, "test-moe-paged-loader: passed\n");
+    return 0;
+}
