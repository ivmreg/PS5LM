+
+struct temp_file {
+    std::string path;
+
+    temp_file() {
+        std::array<char, 64> name{};
+        std::strcpy(name.data(), "/tmp/llama-moe-paged-XXXXXX");
+        const int fd = mkstemp(name.data());
+        if (fd < 0) {
+            throw std::runtime_error("mkstemp failed");
+        }
+        close(fd);
+        path = name.data();
+    }
+
+    temp_file(const temp_file &) = delete;
+    temp_file & operator=(const temp_file &) = delete;
+
+    temp_file(temp_file && other) noexcept : path(std::move(other.path)) {
+        other.path.clear();
+    }
+
+    ~temp_file() {
+        if (!path.empty()) {
+            unlink(path.c_str());
+        }
+    }
+};
+
+static void add_tensor(gguf_context * gguf, ggml_tensor * tensor) {
+    gguf_add_tensor(gguf, tensor);
+    gguf_set_tensor_data(gguf, tensor->name, tensor->data);
+}
+
+static temp_file make_fixture(const char * architecture, bool split) {
+    temp_file file;
+
+    ggml_init_params init{};
+    init.mem_size = 1 << 20;
+    ggml_context * tensors = ggml_init(init);
+    require(tensors != nullptr, "ggml_init failed");
+
+    auto * gate = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * up   = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * down = ggml_new_tensor_3d(tensors, GGML_TYPE_F32, 4, 4, 2);
+    auto * norm = ggml_new_tensor_1d(tensors, GGML_TYPE_F32, 4);
+    require(gate && up && down && norm, "synthetic tensors allocation failed");
+
+    ggml_set_name(gate, "blk.0.ffn_gate_exps.weight");
+    ggml_set_name(up,   "blk.0.ffn_up_exps.weight");
+    ggml_set_name(down, "blk.0.ffn_down_exps.weight");
+    ggml_set_name(norm, "blk.0.attn_norm.weight");
+    std::memset(gate->data, 0x11, ggml_nbytes(gate));
+    std::memset(up->data,   0x22, ggml_nbytes(up));
+    std::memset(down->data, 0x33, ggml_nbytes(down));
+    std::memset(norm->data, 0x44, ggml_nbytes(norm));
+
+    gguf_context * gguf = gguf_init_empty();
+    require(gguf != nullptr, "gguf_init_empty failed");
+    gguf_set_val_str(gguf, "general.architecture", architecture);
+    if (split) {
+        gguf_set_val_u16(gguf, "split.count", 2);
+    }
+    add_tensor(gguf, gate);
+    add_tensor(gguf, up);
+    add_tensor(gguf, down);
+    add_tensor(gguf, norm);
+
+    const bool wrote = gguf_write_to_file(gguf, file.path.c_str(), false);
+    gguf_free(gguf);
+    ggml_free(tensors);
+    require(wrote, "writing synthetic GGUF failed");
+    return file;
+}
+
+static int open_fd_count() {
+    long limit = sysconf(_SC_OPEN_MAX);
+    if (limit <= 0) {
+        limit = 1024;
+    }
+    limit = std::min<long>(limit, 4096);
+    int count = 0;
+    for (int fd = 0; fd < limit; ++fd) {
+        if (fcntl(fd, F_GETFD) >= 0) {
+            ++count;
+        }
+    }
+    return count;
+}
