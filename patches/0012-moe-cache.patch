+static void test_prefill_and_decode_parity(const std::string & fixture_path) {
+    auto mparams_res = llama_model_default_params();
+    mparams_res.use_moe_expert_paging = false;
+    mparams_res.use_extra_bufts = false;
+    llama_model * model_res = llama_model_load_from_file(fixture_path.c_str(), mparams_res);
+    require(model_res != nullptr, "resident model load failed");
+
+    auto mparams_paged = llama_model_default_params();
+    mparams_paged.use_moe_expert_paging = true;
+    mparams_paged.use_extra_bufts = false;
+    llama_model * model_paged = llama_model_load_from_file(fixture_path.c_str(), mparams_paged);
+    require(model_paged != nullptr, "paged model load failed");
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model_res));
+    require(n_vocab > 0, "n_vocab must be positive");
+
+    const std::vector<int> prompt_lengths = { 1, 2, 5, 33 };
+
+    for (int len : prompt_lengths) {
+        std::vector<llama_token> tokens(len);
+        for (int i = 0; i < len; ++i) {
+            tokens[i] = static_cast<llama_token>((i * 7 + 3) % (n_vocab > 10 ? 10 : n_vocab) + 1);
+        }
+
+        // Resident run (normal ubatch)
+        auto cparams_res = llama_context_default_params();
+        cparams_res.n_ctx = len + 16;
+        cparams_res.n_batch = len + 16;
+        cparams_res.n_ubatch = len + 16;
+        cparams_res.n_seq_max = 1;
+        auto logits_res = run_eval_sequence(model_res, cparams_res, tokens, 4);
+
+        // Resident run (1-token ubatch for exact parity check)
+        auto cparams_res_u1 = cparams_res;
+        cparams_res_u1.n_ubatch = 1;
+        auto logits_res_u1 = run_eval_sequence(model_res, cparams_res_u1, tokens, 4);
+
+        // Paged run (n_ubatch=1 bounded)
+        auto cparams_paged = llama_context_default_params();
+        cparams_paged.n_ctx = len + 16;
+        cparams_paged.n_batch = len + 16;
+        cparams_paged.n_ubatch = 1;
+        cparams_paged.n_seq_max = 1;
+        cparams_paged.moe_cache_size = 64 * 1024 * 1024;
+        auto logits_paged = run_eval_sequence(model_paged, cparams_paged, tokens, 4);
+
+        assert_logits_parity(logits_res_u1, logits_paged, 1e-6f);
+        assert_logits_parity(logits_res, logits_paged, 1e-5f);
+    }
+
+    llama_model_free(model_res);
+    llama_model_free(model_paged);
+}
