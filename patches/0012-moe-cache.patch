+// Integration test for Qwen3MoE Non-Resident Expert Paging & Inference Parity.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "llama.h"
+#include "../src/llama-model.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+static void llama_batch_clear(struct llama_batch & batch) {
+    batch.n_tokens = 0;
+}
+
+static void llama_batch_add(
+        struct llama_batch & batch,
+        llama_token id,
+        llama_pos pos,
+        std::initializer_list<llama_seq_id> seq_ids,
+        bool logits) {
+    const int32_t idx = batch.n_tokens;
+    batch.token   [idx] = id;
+    batch.pos     [idx] = pos;
+    batch.n_seq_id[idx] = seq_ids.size();
+    size_t i = 0;
+    for (llama_seq_id sid : seq_ids) {
+        batch.seq_id[idx][i++] = sid;
+    }
+    batch.logits  [idx] = logits;
+    batch.n_tokens++;
+}
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static std::string find_fixture_path(const std::string & rel_path) {
+    const char * env_path = std::getenv("PS5LM_FIXTURE_PATH");
+    if (env_path && access(env_path, R_OK) == 0) {
+        return env_path;
+    }
+    const std::vector<std::string> prefixes = {
+        "",
+        "./",
+        "../",
+        "../../",
+        "../../../",
+        "../../../../",
+    };
+    for (const auto & p : prefixes) {
+        std::string cand = p + rel_path;
+        if (access(cand.c_str(), R_OK) == 0) {
+            return cand;
+        }
+    }
+    return "";
+}
+
+static void assert_logits_parity(const std::vector<float> & a, const std::vector<float> & b, float tol = 1e-5f) {
+    require(a.size() == b.size(), "logits dimension mismatch");
+    float max_diff = 0.0f;
+    for (size_t i = 0; i < a.size(); ++i) {
+        float diff = std::fabs(a[i] - b[i]);
+        if (diff > max_diff) {
+            max_diff = diff;
+        }
+    }
+    if (max_diff >= tol) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf), "logits parity violated: max diff %g >= %g", max_diff, tol);
+        throw std::runtime_error(buf);
+    }
+}
+
+static std::vector<float> run_eval_sequence(
+        llama_model * model,
+        llama_context_params cparams,
+        const std::vector<llama_token> & tokens,
+        int n_decode_steps = 0) {
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    require(ctx != nullptr, "failed to create context for eval");
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<float> result_logits;
+
+    // Prefill tokens
+    llama_batch batch = llama_batch_init(tokens.size() + n_decode_steps, 0, 1);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_batch_add(batch, tokens[i], i, { 0 }, i == tokens.size() - 1);
+    }
+    int ret = llama_decode(ctx, batch);
+    require(ret == 0, "prefill llama_decode failed");
+
+    float * logits = llama_get_logits_ith(ctx, -1);
+    require(logits != nullptr, "null logits after prefill");
+    result_logits.assign(logits, logits + n_vocab);
+
+    // Subsequent single-token decode steps
+    for (int step = 0; step < n_decode_steps; ++step) {
+        llama_token next_token = 0;
+        float max_logit = -std::numeric_limits<float>::infinity();
+        for (int v = 0; v < n_vocab; ++v) {
+            if (logits[v] > max_logit) {
+                max_logit = logits[v];
+                next_token = v;
+            }
+        }
+
+        llama_batch_clear(batch);
+        llama_batch_add(batch, next_token, tokens.size() + step, { 0 }, true);
+
+        ret = llama_decode(ctx, batch);
+        require(ret == 0, "decode step failed");
+
+        logits = llama_get_logits_ith(ctx, -1);
+        require(logits != nullptr, "null logits in decode step");
+        result_logits.insert(result_logits.end(), logits, logits + n_vocab);
+    }
+
+    llama_batch_free(batch);
+    llama_free(ctx);
+    return result_logits;
+}
