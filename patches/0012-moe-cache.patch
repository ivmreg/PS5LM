+static void test_fault_injection_and_recovery(const std::string & fixture_path) {
+    auto mparams_res = llama_model_default_params();
+    mparams_res.use_moe_expert_paging = false;
+    mparams_res.use_extra_bufts = false;
+    llama_model * model_res = llama_model_load_from_file(fixture_path.c_str(), mparams_res);
+    require(model_res != nullptr, "resident model load failed");
+
+    auto mparams_paged = llama_model_default_params();
+    mparams_paged.use_moe_expert_paging = true;
+    mparams_paged.use_extra_bufts = false;
+    llama_model * model_paged = llama_model_load_from_file(fixture_path.c_str(), mparams_paged);
+    require(model_paged != nullptr, "paged model load failed");
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model_res));
+
+    const std::vector<llama_token> tokens = { 1, 2 };
+
+    // Baseline logits on resident model
+    auto cparams_res = llama_context_default_params();
+    cparams_res.n_ctx = 32;
+    cparams_res.n_batch = 32;
+    cparams_res.n_ubatch = 32;
+    cparams_res.n_seq_max = 1;
+    auto logits_baseline = run_eval_sequence(model_res, cparams_res, tokens, 1);
+
+    // Paged context
+    auto cparams_paged = llama_context_default_params();
+    cparams_paged.n_ctx = 32;
+    cparams_paged.n_batch = 32;
+    cparams_paged.n_ubatch = 1;
+    cparams_paged.n_seq_max = 1;
+    cparams_paged.moe_cache_size = 32 * 1024 * 1024;
+    llama_context * ctx_paged = llama_init_from_model(model_paged, cparams_paged);
+    require(ctx_paged != nullptr, "paged context init failed");
+
+    // 1. Initial prefill succeeds
+    llama_batch batch = llama_batch_init(32, 0, 1);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_batch_add(batch, tokens[i], i, { 0 }, i == tokens.size() - 1);
+    }
+    int ret = llama_decode(ctx_paged, batch);
+    require(ret == 0, "initial prefill failed");
+
+    // A malformed router ID must fail the request, not terminate the process.
+    llama_moe_set_fault_injection(ctx_paged, true, -2);
+    llama_batch_clear(batch);
+    llama_batch_add(batch, 3, tokens.size(), { 0 }, true);
+    ret = llama_decode(ctx_paged, batch);
+    require(ret == -3, "invalid router ID must return a graph error");
+    llama_moe_set_fault_injection(ctx_paged, false, 0);
+    llama_memory_clear(llama_get_memory(ctx_paged), true);
+    llama_batch_clear(batch);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_batch_add(batch, tokens[i], i, { 0 }, i == tokens.size() - 1);
+    }
+    ret = llama_decode(ctx_paged, batch);
+    require(ret == 0, "prefill after invalid router ID failed");
+
+    // 2. Inject fault on next upload
+    llama_moe_set_fault_injection(ctx_paged, true, 0);
+
+    llama_batch_clear(batch);
+    llama_batch_add(batch, 3, tokens.size(), { 0 }, true);
+
+    ret = llama_decode(ctx_paged, batch);
+    // Must fail closed with error code -3 (GGML_STATUS_FAILED)
+    require(ret != 0, "decode must fail closed under fault injection");
+    require(ret == -3, "decode error return code must be -3");
+
+    // 3. Clear fault injection and recover
+    llama_moe_set_fault_injection(ctx_paged, false, 0);
+
+    // Clear KV cache and context state
+    llama_memory_clear(llama_get_memory(ctx_paged), true);
+
+    // 4. Retry sequence from scratch - must succeed and match baseline
+    llama_batch_clear(batch);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_batch_add(batch, tokens[i], i, { 0 }, i == tokens.size() - 1);
+    }
+    ret = llama_decode(ctx_paged, batch);
+    require(ret == 0, "recovery prefill failed");
+
+    float * logits = llama_get_logits_ith(ctx_paged, -1);
+    require(logits != nullptr, "null logits on recovery prefill");
+    std::vector<float> recovered_logits(logits, logits + n_vocab);
+
+    llama_token next_token = 0;
+    float max_logit = -std::numeric_limits<float>::infinity();
+    for (int v = 0; v < n_vocab; ++v) {
+        if (logits[v] > max_logit) {
+            max_logit = logits[v];
+            next_token = v;
+        }
+    }
+
+    llama_batch_clear(batch);
+    llama_batch_add(batch, next_token, tokens.size(), { 0 }, true);
+    ret = llama_decode(ctx_paged, batch);
+    require(ret == 0, "recovery decode step failed");
+
+    logits = llama_get_logits_ith(ctx_paged, -1);
+    require(logits != nullptr, "null logits on recovery decode");
+    recovered_logits.insert(recovered_logits.end(), logits, logits + n_vocab);
+
+    assert_logits_parity(logits_baseline, recovered_logits, 1e-5f);
+
+    llama_batch_free(batch);
+    llama_free(ctx_paged);
+    llama_model_free(model_res);
+    llama_model_free(model_paged);
+}
