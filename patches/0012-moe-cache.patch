diff --git a/tests/test-moe-cache-slot-map.cpp b/tests/test-moe-cache-slot-map.cpp
new file mode 100644
index 0000000..4372929
--- /dev/null
+++ b/tests/test-moe-cache-slot-map.cpp
@@ -0,0 +1,110 @@
+#include "../src/llama-moe-cache.h"
+
+#include "paging_runtime.hpp"
+#include "slot_cache.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using namespace ps5lm::moe;
+
+static void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+static PagingResult reserve_and_commit(
+        SlotCache & cache,
+        uint32_t layer,
+        const std::vector<uint32_t> & experts,
+        CompletionToken token) {
+    std::vector<ExpertKey> requested;
+    requested.reserve(experts.size());
+    for (uint32_t expert : experts) {
+        requested.push_back({layer, expert});
+    }
+
+    ReserveResult reserved = cache.reserve(requested);
+    require(reserved.ok(), "slot cache reservation failed");
+    for (const SlotAssignment & assignment : reserved.reservation.assignments()) {
+        if (assignment.needs_upload) {
+            require(reserved.reservation.mark_upload_complete(assignment.key) == SlotCacheStatus::Ok,
+                    "marking synthetic upload complete failed");
+        }
+    }
+
+    PagingResult result;
+    result.status = PagingStatus::Ok;
+    result.assignments = reserved.reservation.assignments();
+    require(reserved.reservation.commit(token) == SlotCacheStatus::Ok, "slot cache commit failed");
+    return result;
+}
+
+static void check_selected_mapping(
+        const SlotCache & cache,
+        uint32_t layer,
+        const std::vector<uint32_t> & selected,
+        const std::vector<int32_t> & slot_map) {
+    for (uint32_t expert : selected) {
+        std::size_t resident_slot = kNoSlot;
+        require(cache.find_slot({layer, expert}, &resident_slot), "selected expert is not resident");
+        require(slot_map[expert] == static_cast<int32_t>(resident_slot),
+                "selected-ID mapping differs from resident cache mapping");
+    }
+}
+
+int main() {
+    try {
+        constexpr uint32_t layer = 5;
+        constexpr int32_t expert_count = 4;
+        SlotCacheOptions options;
+        options.slot_count = 2;
+        options.bytes_per_slot = 1;
+        options.byte_budget = 2;
+        options.max_in_flight_tokens = 8;
+        options.max_request_keys = 8;
+        SlotCache cache(options);
+        require(cache.configuration_status() == SlotCacheStatus::Ok, "slot cache configuration failed");
+        std::vector<int32_t> slot_map(expert_count, -1);
+
+        // First access includes a duplicate ID and two misses.
+        const std::vector<uint32_t> first_selected{0, 1, 0};
+        PagingResult first = reserve_and_commit(cache, layer, first_selected, 1);
+        require(first.assignments.size() == 2, "duplicate expert consumed an extra assignment");
+        llama_moe_cache_detail::rebuild_slot_map(slot_map.data(), expert_count, first);
+        check_selected_mapping(cache, layer, first_selected, slot_map);
+        require(slot_map[2] == -1 && slot_map[3] == -1, "unselected experts must stay unmapped");
+        require(cache.complete(1) == SlotCacheStatus::Ok, "completing first cache use failed");
+
+        // Expert 1 is a hit; 2 is a miss that evicts 0. The new map must keep
+        // the hit's slot and clear the evicted expert's stale mapping.
+        const std::vector<uint32_t> second_selected{1, 2, 1};
+        PagingResult second = reserve_and_commit(cache, layer, second_selected, 2);
+        require(second.assignments.size() == 2, "hit plus miss assignment count is wrong");
+        llama_moe_cache_detail::rebuild_slot_map(slot_map.data(), expert_count, second);
+        check_selected_mapping(cache, layer, second_selected, slot_map);
+        require(slot_map[0] == -1, "evicted expert retained a stale slot-map entry");
+        require(cache.complete(2) == SlotCacheStatus::Ok, "completing second cache use failed");
+
+        // A repeated lookup of the same layer exercises another hit, another
+        // eviction, and duplicate selected IDs after the map was reused.
+        const std::vector<uint32_t> third_selected{2, 3, 2};
+        PagingResult third = reserve_and_commit(cache, layer, third_selected, 3);
+        require(third.assignments.size() == 2, "second hit plus miss assignment count is wrong");
+        llama_moe_cache_detail::rebuild_slot_map(slot_map.data(), expert_count, third);
+        check_selected_mapping(cache, layer, third_selected, slot_map);
+        require(slot_map[1] == -1, "second evicted expert retained a stale slot-map entry");
+        require(cache.complete(3) == SlotCacheStatus::Ok, "completing third cache use failed");
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "test-moe-cache-slot-map: %s\n", e.what());
+        return 1;
+    }
+
+    std::fprintf(stderr, "test-moe-cache-slot-map: passed\n");
+    return 0;
+}
