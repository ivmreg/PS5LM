+static void test_warmup_and_eviction_parity(const std::string & fixture_path) {
+    auto mparams_res = llama_model_default_params();
+    mparams_res.use_moe_expert_paging = false;
+    mparams_res.use_extra_bufts = false;
+    llama_model * model_res = llama_model_load_from_file(fixture_path.c_str(), mparams_res);
+    require(model_res != nullptr, "resident model load failed");
+
+    auto mparams_paged = llama_model_default_params();
+    mparams_paged.use_moe_expert_paging = true;
+    mparams_paged.use_extra_bufts = false;
+    llama_model * model_paged = llama_model_load_from_file(fixture_path.c_str(), mparams_paged);
+    require(model_paged != nullptr, "paged model load failed");
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model_res));
+    const int total_tokens = 25;
+
+    std::vector<llama_token> tokens(3);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        tokens[i] = static_cast<llama_token>((i + 1) % n_vocab);
+    }
+
+    // Resident baseline for 3 prompt tokens + 22 decode steps
+    auto cparams_res = llama_context_default_params();
+    cparams_res.n_ctx = total_tokens + 8;
+    cparams_res.n_batch = total_tokens + 8;
+    cparams_res.n_ubatch = total_tokens + 8;
+    cparams_res.n_seq_max = 1;
+    auto logits_res = run_eval_sequence(model_res, cparams_res, tokens, 22);
+
+    // Paged run with warmup and forced repeated evictions
+    auto cparams_paged = llama_context_default_params();
+    cparams_paged.n_ctx = total_tokens + 8;
+    cparams_paged.n_batch = total_tokens + 8;
+    cparams_paged.n_ubatch = 1;
+    cparams_paged.n_seq_max = 1;
+    cparams_paged.moe_cache_size = 4 * 1024 * 1024; // smaller budget forcing repeated eviction
+
+    llama_context * ctx_paged = llama_init_from_model(model_paged, cparams_paged);
+    require(ctx_paged != nullptr, "failed to create paged context");
+
+    // Exercise warmup transition
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+    llama_set_warmup(ctx_paged, true);
+    llama_set_warmup(ctx_paged, false);
+#pragma GCC diagnostic pop
+
+    llama_batch batch = llama_batch_init(total_tokens + 8, 0, 1);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_batch_add(batch, tokens[i], i, { 0 }, i == tokens.size() - 1);
+    }
+    int ret = llama_decode(ctx_paged, batch);
+    require(ret == 0, "paged prefill failed");
+
+    std::vector<float> logits_paged;
+    float * cur_logits = llama_get_logits_ith(ctx_paged, -1);
+    require(cur_logits != nullptr, "null logits");
+    logits_paged.assign(cur_logits, cur_logits + n_vocab);
+
+    for (int step = 0; step < 22; ++step) {
+        llama_token next_token = 0;
+        float max_logit = -std::numeric_limits<float>::infinity();
+        for (int v = 0; v < n_vocab; ++v) {
+            if (cur_logits[v] > max_logit) {
+                max_logit = cur_logits[v];
+                next_token = v;
+            }
+        }
+
+        llama_batch_clear(batch);
+        llama_batch_add(batch, next_token, tokens.size() + step, { 0 }, true);
+
+        ret = llama_decode(ctx_paged, batch);
+        require(ret == 0, "paged decode step failed");
+
+        cur_logits = llama_get_logits_ith(ctx_paged, -1);
+        require(cur_logits != nullptr, "null logits in decode step");
+        logits_paged.insert(logits_paged.end(), cur_logits, cur_logits + n_vocab);
+    }
+
+    llama_batch_free(batch);
+    llama_free(ctx_paged);
+
+    assert_logits_parity(logits_res, logits_paged, 1e-5f);
+
+    llama_model_free(model_res);
+    llama_model_free(model_paged);
+}
